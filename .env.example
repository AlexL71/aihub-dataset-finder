# Copy to .env and fill in. Never commit .env.
# Optional: contact email added to the collector User-Agent
CONTACT_EMAIL=
# Optional: AI Hub session cookie (from your own logged-in browser), used only by: collect_aihub docs --use-cookie
AIHUB_COOKIE=
# Google Gemini API key: embeddings for search (processing/embed.py)
GEMINI_API_KEY=
# K-EXAONE API key from docs.exaone.ai, for your own local testing only (its terms do not allow student use; keys expire after 30 days)
K-EXAONE_API_KEY=
